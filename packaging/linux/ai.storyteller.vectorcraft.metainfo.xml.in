<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.vectorcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Kaleiform</name>
  <name xml:lang="zh_CN">虹构</name>
  <summary>Open-source vector illustration and CJK typography</summary>
  <summary xml:lang="zh_CN">开源矢量绘图与中文排版</summary>
  <developer id="io.github.pengjingyu1992">
    <name>Kaleiform contributors</name>
  </developer>
  <url type="homepage">https://github.com/Pengjingyu1992/Kaleiform</url>
  <url type="bugtracker">https://github.com/Pengjingyu1992/Kaleiform/issues</url>
  <description>
    <p>
      Kaleiform is an open-source vector illustration app. Draw with pen, shape and brush tools,
      style art with fills, strokes, gradients and live effects, lay out artboards and type, and
      open and save SVG and PDF.
    </p>
    <p xml:lang="zh_CN">虹构是开源矢量绘图应用，支持钢笔、形状和画笔工具，填色、描边、渐变与实时效果，画板和文字排版，以及 SVG 和 PDF 的打开与保存。</p>
  </description>
  <launchable type="desktop-id">ai.storyteller.vectorcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.vectorcraft</icon>
  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>VectorGraphics</category>
  </categories>
  <keywords>
    <keyword>vector</keyword>
    <keyword>illustration</keyword>
    <keyword>svg</keyword>
    <keyword>pdf</keyword>
    <keyword>drawing</keyword>
    <keyword>bezier</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>vectorcraft</binary>
    <binary>vectorcraft-cli</binary>
    <mediatype>application/x-vectorcraft</mediatype>
    <mediatype>application/x-vectorcraft-template</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
